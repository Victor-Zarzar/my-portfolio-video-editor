{
  "name": "my-portfolio-video-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "victorzarzar (https://github.com/Victor-Zarzar)",
  "repository": "https://github.com/Victor-Zarzar/my-portfolio-video-editor",
  "bugs": {
    "url": "https://github.com/Victor-Zarzar/my-portfolio-video-editor/issues"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun typegen && bun typecheck && bun lint",
    "check:commit": "bun run paraglide:compile && bun check && bun test:unit && bun test:integration",
    "check:push": "bun install:e2e && bun test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typegen": "tsr generate",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "bun run paraglide:compile && bun run typegen && tsc --noEmit",
    "test:unit": "bun test tests/units --isolate",
    "test:integration": "bun test tests/integration --isolate",
    "test:integration:watch": "bun test tests/integration --watch --isolate",
    "install:e2e": "bunx playwright install",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "install:netlifycli": "npm install -g netlify-cli",
    "deploy:dev": "netlify deploy",
    "deploy:prod": "netlify deploy --prod",
    "clean": "rm -rf node_modules .netlify .tanstack dist tsconfig.tsbuildinfo playwright-report test-results",
    "update-deps": "bun update",
    "update-latest": "bun update --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/tanstackstart-react": "^11.9.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-start-server": "^1.167.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-resizable-panels": "^4.15.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@inlang/paraglide-js": "^2.29.2",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
