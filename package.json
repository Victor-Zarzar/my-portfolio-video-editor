{
  "name": "my-portfolio-video-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "victorzarzar (https://github.com/Victor-Zarzar)",
  "repository": "https://github.com/Victor-Zarzar/my-portfolio-video-editor",
  "bugs": {
    "url": "https://github.com/Victor-Zarzar/my-portfolio-video-editor/issues"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun typecheck && bun lint && bun typegen",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typegen": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/units --isolate",
    "install:netlifycli": "npm install -g netlify-cli",
    "deploy:dev": "netlify deploy",
    "deploy:prod": "netlify deploy --prod",
    "clean": "rm -rf node_modules .netlify .tanstack dist tsconfig.tsbuildinfo playwright-report test-results",
    "update-deps": "bun update",
    "update-latest": "bun update --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/tanstackstart-react": "^10.72.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@happy-dom/global-registrator": "^20.12.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp"
    ]
  }
}
